{
  "name": "obsidian-plugin-issue-bridge",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Connect assigned GitHub issues to native tasks in existing Obsidian notes.",
  "license": "MIT",
  "author": "Michael J. Stallinger",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "deploy": "npm run check && node scripts/deploy.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "latest",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.73.0"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "overrides": {
    "eslint-plugin-n": {
      "minimatch": "11.0.1"
    }
  }
}
